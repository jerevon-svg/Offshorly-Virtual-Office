# MOCK-RIG ONLY — loaded by `npm run dev:mock` (vite --mode mock), which serves the mock
# frontend on localhost:5174. Vite applies .env.[mode] AFTER .env.local, so every value here
# overrides the real-mode settings in .env.local for this instance only; the ordinary
# `npm run dev` on :5173 never reads this file.
#
# Non-secret by construction: these are mode flags and localhost URLs. Real keys stay in .env
# (gitignored) and are server-side only.

# Point the Hub / chat / feed REST + Socket.IO client at the MOCK backend
# (backend/run-mock-hub-backend.sh — :8002, its own dev_hub_playground.db), never at the
# ordinary local backend on :8001 and never at Atlas on :8000.
VITE_CHAT_MODE=real
VITE_CHAT_SOCKET_URL=http://localhost:8002

# Toucan must be stated EXPLICITLY here, unlike the other mock flags, because it is the one
# setting .env.local turns on (VITE_TOUCAN_MODE=real). Vite layers .env.local under
# .env.[mode], so anything this file does not name simply leaks through — and Toucan's real
# mode would then ride on VITE_CHAT_SOCKET_URL above, quietly pointing the mock rig's bird at
# the mock backend's live POST /toucan/ask instead of the canned replies in
# src/services/toucan/MockToucanService.ts. Absent this line the isolated rig is not isolated.
VITE_TOUCAN_MODE=mock

# Atlas is not part of this rig. The office cast comes from the static manifest instead of
# Atlas's office API, and the permission gate is skipped, so :5174 boots with Atlas stopped.
VITE_OFFICE_INTEGRATION_MODE=mock
VITE_ZOHO_INTEGRATION_MODE=mock
VITE_AVATAR_GENERATION_MODE=mock
VITE_AUTH_GATE=off

# Deliberately pointed at the MOCK backend, not at Atlas. With VITE_AUTH_GATE=off nothing
# should call Atlas at all (no /auth/me, office data comes from the static manifest), but if
# some path ever does, this guarantees where it lands: the mock FastAPI has no /api/v1/* routes,
# so a stray request 404s locally instead of reaching Atlas on :8000. Leaving it EMPTY is not
# equivalent — resolveApiBase() in src/services/api/client.ts throws on an unset value.
VITE_API_URL=http://localhost:8002

# Attendance must ALSO be real here, or Check In never leaves the browser. The flag defaults to
# "mock" when unset (src/services/attendance/index.ts), and .env.local does not set it, so
# without this line the rig's Check In writes localStorage only and never calls the mock
# backend's POST /attendance/check-in — which is where server-authoritative state (and Quest
# Foundation's check_in event) lives. Same base URL as chat/hub/feed above (:8002). Pinned by
# src/services/attendance/mockRigConfig.test.ts after manual acceptance exposed the gap.
VITE_ATTENDANCE_MODE=real
