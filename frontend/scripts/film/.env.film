# FILM RIG ONLY — loaded by vite.film.config.ts (envDir = this folder), so NONE of the frontend's
# own .env / .env.local / .env.mock files are read by the :5175 film server. Every request goes to
# the isolated film backend (backend/run-film-backend.sh, :8003, dev_film.db). Non-secret flags only.
VITE_CHAT_MODE=real
VITE_CHAT_SOCKET_URL=http://localhost:8003
VITE_TOUCAN_MODE=real
VITE_OFFICE_INTEGRATION_MODE=mock
VITE_ZOHO_INTEGRATION_MODE=mock
VITE_AVATAR_GENERATION_MODE=mock
VITE_AUTH_GATE=off
VITE_API_URL=http://localhost:8003
VITE_ATTENDANCE_MODE=real
VITE_DEV_USER_EMAIL=jerevon@offshorly.com
