# "mock" uses in-memory sample Zoho data; "mcp" routes through Zoho MCP
# once connected (currently throws — not implemented). Defaults to "mock"
# if unset or set to an unrecognized value.
VITE_ZOHO_INTEGRATION_MODE=mock

# "mock" cycles stand-in portrait images for the avatar creator; "real"
# routes through an actual image-generation provider (currently throws —
# not implemented). Defaults to "mock" if unset or unrecognized.
VITE_AVATAR_GENERATION_MODE=mock

# Atlas backend base URL. Used to build ABSOLUTE API request URLs (see
# src/services/api/client.ts) — never construct a relative "/api/..." path,
# because under the atlas.offshorly.com/virtual-office reverse proxy a
# relative path resolves against Atlas's own origin, which has no such
# routes and returns Atlas's HTML 404 where JSON is expected.
# This value is INLINED into the JS bundle at build time (Vite static
# build, no server-side runtime env) — changing it requires a rebuild
# and redeploy, not just an env var flip.
VITE_API_URL=https://atlas-api.offshorly.com

# Set to "off" in .env.local to skip the Atlas permission gate
# (src/auth/useAuthGate.ts) so the office boots without an Atlas account or
# the can_view_virtual_office flag. DEV-ONLY — the branch is compiled out of
# `vite build`, so this has no effect on a deployed bundle. Leave unset here.
VITE_AUTH_GATE=

# OpenAI key — used for GPT-image chibi-portrait + pose generation
# (offline Node script, Track 1). Not prefixed with VITE_ — must never
# be bundled into client-side JS.
OPENAI_API_KEY=

# Gemini key — used for the photo-to-house-style-illustration step
# (offline Node script, Track 1). Not prefixed with VITE_ — must never
# be bundled into client-side JS.
GEMINI_API_KEY=
