# "real" routes time-logging through Atlas's backend
# (GET /api/v1/office/my-tasks, POST /api/v1/office/my-timelogs), which owns
# the Zoho OAuth connection — the browser never holds Zoho credentials.
# "mock" uses in-memory sample data. "mcp" is retained only so a stale env
# value fails loudly (every method throws) instead of silently returning
# fake data; it was never viable from an SPA. Defaults to "mock" if unset or
# unrecognized, which renders hardcoded sample projects — see
# docs/OFFICE_TIMELOG_IMPLEMENTATION.md in the Atlas repo.
VITE_ZOHO_INTEGRATION_MODE=mock

# "mock" cycles stand-in portrait images for the avatar creator; "real"
# routes through an actual image-generation provider (currently throws —
# not implemented). Defaults to "mock" if unset or unrecognized.
VITE_AVATAR_GENERATION_MODE=mock

# Atlas backend base URL. Used to build ABSOLUTE API request URLs (see
# src/services/api/client.ts) — never construct a relative "/api/..." path,
# because under the atlas.offshorly.com/virtual-office reverse proxy a
# relative path resolves against Atlas's own origin, which has no such
# routes and returns Atlas's HTML 404 where JSON is expected.
# This value is INLINED into the JS bundle at build time (Vite static
# build, no server-side runtime env) — changing it requires a rebuild
# and redeploy, not just an env var flip.
VITE_API_URL=https://atlas-api.offshorly.com

# "mock" serves the office cast from the static manifest's own character
# layers, so the app runs with the Atlas backend stopped; "real" reads live
# people from Atlas's office API (src/services/office/). Defaults to "mock"
# if unset or unrecognized — a missing value degrades to the offline cast
# rather than firing requests at whatever VITE_API_URL points at.
VITE_OFFICE_INTEGRATION_MODE=mock

# Set to "off" in .env.local to skip the Atlas permission gate
# (src/auth/useAuthGate.ts) so the office boots without an Atlas account or
# the can_view_virtual_office flag. DEV-ONLY — the branch is compiled out of
# `vite build`, so this has no effect on a deployed bundle. Leave unset here.
VITE_AUTH_GATE=

# "mock" keeps chat entirely client-side (localStorage + canned auto-echo,
# see src/services/chat/MockChatService.ts); "real" talks to the Phase 3
# backend (../backend/) over REST + Socket.IO. Explicit "mock"/"real" always
# wins. If unset or unrecognized, mode is inferred from VITE_CHAT_SOCKET_URL
# below: a non-empty socket URL implies "real", otherwise "mock".
VITE_CHAT_MODE=real

# Base URL of the Phase 3 chat backend (../backend/), used for both its REST
# endpoints and its Socket.IO connection. Read whenever chat mode resolves to
# "real" — either via VITE_CHAT_MODE=real above or, if that's unset, because
# this URL is itself non-empty (see resolveMode() in src/services/chat/index.ts).
# Inlined at build time like VITE_API_URL above — same rebuild-required
# caveat applies. In production this must be reachable over wss:// (Socket.IO
# negotiates this automatically from an https:// base).
VITE_CHAT_SOCKET_URL=http://localhost:4800

# OpenAI key — used for GPT-image chibi-portrait + pose generation
# (offline Node script, Track 1). Not prefixed with VITE_ — must never
# be bundled into client-side JS.
OPENAI_API_KEY=

# Gemini key — used for the photo-to-house-style-illustration step
# (offline Node script, Track 1). Not prefixed with VITE_ — must never
# be bundled into client-side JS.
GEMINI_API_KEY=
