    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
