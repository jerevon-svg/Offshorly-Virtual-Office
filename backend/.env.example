# Postgres connection string, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Base URL of Atlas's API (identity is verified by calling
# ${ATLAS_API_URL}/api/v1/auth/me with the caller's bearer token — this
# backend never checks JWT signatures locally).
ATLAS_API_URL=https://atlas-api.offshorly.com

PORT=4800

# Comma-separated list of allowed CORS origins (the Atlas-proxied frontend
# origin(s), e.g. https://atlas.offshorly.com). In production this MUST be
# the real origin(s), not "*".
CORS_ORIGIN=http://localhost:5173

# Dev-only convenience: when NODE_ENV !== "production", requests/sockets may
# supply an "x-dev-email" header/query param instead of a real Atlas bearer
# token, to allow local two-browser testing without live Atlas credentials.
# This is hard-gated off in production — see src/auth/verifyAtlasToken.ts.
NODE_ENV=development
