# --- FastAPI backend ---
APP_NAME=Virtual Office
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./virtual_office.db
# DATABASE_URL=postgresql://user:password@localhost:5432/virtual_office

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Base URL of Atlas's API (chat identity is verified by calling
# ${ATLAS_API_URL}/api/v1/auth/me with the caller's bearer token — this
# backend never checks JWT signatures locally). Used by app/auth/atlas.py.
ATLAS_API_URL=https://atlas-api.offshorly.com

# FUTURE multi-worker realtime seam — leave UNSET. Empty means the only supported mode today:
# one worker, in-process Socket.IO manager, in-memory realtime registries. Setting it does not
# connect to Redis (nothing is installed or required); see backend/app/realtime/state.py.
# REALTIME_REDIS_URL=

# Real weather for the V2 3D office's AUTO mode (WeatherAPI.com).
# BACKEND-ONLY — never mirror this into a VITE_* var; a key in a browser bundle is a published key.
# Leave empty to run without live weather: /weather/office answers 200 with source="unavailable"
# and the office stays on CLEAR (or whatever was last seen). Get a free key at weatherapi.com.
WEATHER_API_KEY=
# The one office location, as "lat,lon" (default is the Manila office). A city name or postcode
# also works, but coordinates cannot be resolved to the wrong place.
WEATHER_LOCATION=14.5995,120.9842
# Seconds one upstream reading serves every caller. This cache, not client discipline, is what
# keeps request volume off WeatherAPI.
WEATHER_CACHE_SECONDS=900
